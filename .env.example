# Cash Culture environment variables.
# Copy to .env.local for local dev, and set the same names in Vercel project settings.
# Never commit real keys. Everything below is a placeholder.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://cash-culture.vercel.app

# ---- Stripe (luxury checkout) ----
# When STRIPE_SECRET_KEY is set, /api/checkout builds a real Checkout Session.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Linked Stripe Price IDs (price_...). When set, checkout references the real
# Stripe price so the sale attributes to that product. MUST be a one-time price
# (recurring prices fail one-time checkout). Use the test price_... in test mode
# and the live price_... in production.
STRIPE_PRICE_TRENCH=
# Fallback Payment Links (used only when STRIPE_SECRET_KEY is absent):
STRIPE_PAYMENT_LINK_TRENCH=
STRIPE_PAYMENT_LINK_BEANIE=
STRIPE_PAYMENT_LINK_ESSENTIALS=
# Webhook signing secret (whsec_...) for /api/stripe-webhook. Required for
# auto-fulfillment. Create the endpoint in Stripe -> Developers -> Webhooks,
# subscribed to `checkout.session.completed`.
STRIPE_WEBHOOK_SECRET=

# ---- Fulfillment routing ----
# /api/stripe-webhook fulfills paid orders. It PREFERS the Wix bridge below when
# WIX_API_KEY + WIX_SITE_ID are set; otherwise it falls back to the Tapstitch
# Enterprise API. With neither configured it no-ops (orders still appear in
# Stripe + the receipt email, so you can fulfill by hand).

# ---- Wix bridge (recommended: routes orders Stripe -> Wix -> Tapstitch) ----
# Wix's order API key is self-serve, and Wix's free Tapstitch app fulfills any
# paid order in the connected store. So we create a PAID Wix order after payment
# and let Wix forward it to Tapstitch. See lib/wix.ts. You must also map each
# product to its Wix catalog Product/Variant id in data/wix.ts.
#   WIX_API_KEY: manage.wix.com -> Settings -> API Keys (give it Stores/Orders perms)
#   WIX_SITE_ID: the Wix site (store) id that has the Tapstitch app installed
WIX_API_KEY=
WIX_SITE_ID=
# Optional: some API keys require the account id header; the Stores app id only
# needs overriding if Wix changes it (defaults to the standard Wix Stores app id).
WIX_ACCOUNT_ID=
WIX_STORES_APP_ID=

# ---- Tapstitch (print-on-demand fulfillment, Enterprise API) ----
# Fallback path, used only when the Wix bridge above is NOT configured. When both
# are set, /api/stripe-webhook auto-creates a Tapstitch dropship order after
# payment. Confirm the API base URL/auth with your Tapstitch account, and map
# each product's variant id(s) in data/tapstitch.ts.
TAPSTITCH_API_URL=
TAPSTITCH_API_KEY=

# ---- Beehiiv (email capture: popup, footer, ambassador) ----
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_POPUP_FORM_ID=
BEEHIIV_FOOTER_FORM_ID=

# ---- Welcome discount code ----
# The email popup reveals this code after signup and emails it via Resend
# (RESEND_API_KEY above). Create a matching discount in Shopify Admin ->
# Discounts (15% off, "limit to one use per customer") so each customer can
# redeem it once. Defaults to "CashMember15"; only set this to change the code.
WELCOME_CODE=

# ---- Airtable (ambassador applications) ----
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_AMBASSADOR_TABLE=Ambassador Applications

# ---- Ambassador fallback + notifications ----
FORMSPREE_AMBASSADOR_ID=
NOTIFY_EMAIL=cashculturebrand@gmail.com
RESEND_API_KEY=

# ---- Order receipts ----
# On `checkout.session.completed`, /api/stripe-webhook emails the customer a
# branded receipt via Resend (RESEND_API_KEY above). Set ORDER_EMAIL_FROM to a
# verified Resend domain sender for real receipts (e.g. "Cash Culture
# <orders@cashculturebrand.com>"); until then it falls back to the Resend test
# sender. The /checkout/success page also renders an on-screen receipt from the
# Stripe session, so STRIPE_SECRET_KEY powers both.
# Optional backstop: enable Stripe Dashboard -> Settings -> Customer emails ->
# "Successful payments" to also send Stripe's own (Stripe-branded) receipt.
ORDER_EMAIL_FROM=

# ---- Customer accounts (/account) ----
# Secret used to sign login-code challenges + session cookies (HMAC-SHA256).
# Required for sign-in to work. Generate a long random value, e.g.
#   openssl rand -base64 32
# Order history is read live from Stripe (no database), so STRIPE_SECRET_KEY
# powers purchase history and RESEND_API_KEY delivers the login codes.
ACCOUNT_SESSION_SECRET=

# ---- Admin dashboard (Phase 2) ----
ADMIN_PASSCODE=

# ---- Vercel CLI / automation (tooling only, NOT app runtime) ----
# Used by the `vercel` CLI for non-interactive / CI auth. See VERCEL.md.
# Create at https://vercel.com/account/tokens. Treat as a secret; never commit.
VERCEL_TOKEN=
# Link a checkout without `vercel link` (find via `vercel project ls` / project settings):
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
